# ==============================================================
# BrandPilot Enterprise Production Configuration
# Copy this file to .env in production environments
# ==============================================================

# Core Application Settings
ENVIRONMENT=production
BRANDPILOT_PORT=8000
BRANDPILOT_DOMAIN=brand.auracloud.io
DATA_RESIDENCY_REGION=us-east-1

# Managed Supabase / Enterprise PostgreSQL (pgvector)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI / Foundation Embedding Model API (Zero Data Retention Active)
OPENAI_API_KEY=sk-proj-your-openai-enterprise-key
EMBEDDING_MODEL=text-embedding-3-small
RAG_SIMILARITY_THRESHOLD=0.75

# Enterprise Single Sign-On (SAML 2.0 / Okta / Azure AD)
SAML_IDP_METADATA_URL=https://idp.okta.com/app/your-app-id/sso/saml/metadata
SAML_SP_ENTITY_ID=https://auth.brandpilot.ai/saml/v1/sp/org-auracloud-001
SAML_ACS_URL=https://auth.brandpilot.ai/saml/v1/acs/org-auracloud-001
SCIM_BEARER_TOKEN=your-scim-directory-sync-token

# Outbound Event Webhooks (HMAC-SHA256 Signing)
WEBHOOK_SIGNING_SECRET=whsec_live_9b42e718c30f4a9b

# Stripe Enterprise Customer Portal & Invoicing
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
